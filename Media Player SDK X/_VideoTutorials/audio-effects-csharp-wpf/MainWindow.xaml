<Window x:Class="AudioEffectsWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vf="clr-namespace:VisioForge.Core.UI.WPF;assembly=VisioForge.Core"
        Title="Audio Effects" Height="760" Width="1200"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <vf:VideoView x:Name="VideoView1" Background="Black" />

        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock x:Name="lbTime" DockPanel.Dock="Right" Text="00:00:00 / 00:00:00"
                       Margin="10,0,0,0" VerticalAlignment="Center" />
            <Slider x:Name="slTimeline" IsMoveToPointEnabled="True"
                    ValueChanged="slTimeline_ValueChanged"
                    Thumb.DragCompleted="slTimeline_DragCompleted" />
        </DockPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="btPlay" Content="Play" Width="90" IsEnabled="False" Click="btPlay_Click" />
            <Button x:Name="btPause" Content="Pause" Width="90" Margin="10,0,0,0" IsEnabled="False"
                    Click="btPause_Click" />
            <Button x:Name="btResume" Content="Resume" Width="90" Margin="10,0,0,0" IsEnabled="False"
                    Click="btResume_Click" />
            <Button x:Name="btStop" Content="Stop" Width="90" Margin="10,0,0,0" IsEnabled="False"
                    Click="btStop_Click" />
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
            <GroupBox Padding="5">
                <GroupBox.Header>
                    <CheckBox x:Name="cbEqualizer" Content="Equalizer, dB"
                              Checked="cbEqualizer_Changed" Unchecked="cbEqualizer_Changed" />
                </GroupBox.Header>
                <!-- One vertical slider per band, Tag = the band's index -->
                <UniformGrid Rows="2" Columns="10">
                    <UniformGrid.Resources>
                        <Style TargetType="Slider">
                            <Setter Property="Orientation" Value="Vertical" />
                            <Setter Property="Height" Value="110" />
                            <Setter Property="Minimum" Value="-12" />
                            <Setter Property="Maximum" Value="12" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="AutoToolTipPlacement" Value="TopLeft" />
                            <EventSetter Event="ValueChanged" Handler="slBand_ValueChanged" />
                        </Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="4,2,4,0" />
                        </Style>
                    </UniformGrid.Resources>
                    <Slider Tag="0" /><Slider Tag="1" /><Slider Tag="2" /><Slider Tag="3" /><Slider Tag="4" />
                    <Slider Tag="5" /><Slider Tag="6" /><Slider Tag="7" /><Slider Tag="8" /><Slider Tag="9" />
                    <TextBlock Text="30" /><TextBlock Text="60" /><TextBlock Text="120" /><TextBlock Text="240" />
                    <TextBlock Text="470" /><TextBlock Text="950" /><TextBlock Text="1.9K" /><TextBlock Text="3.8K" />
                    <TextBlock Text="7.5K" /><TextBlock Text="15K" />
                </UniformGrid>
            </GroupBox>

            <GroupBox Width="200" Margin="10,0,0,0" Padding="5">
                <GroupBox.Header>
                    <CheckBox x:Name="cbEcho" Content="Echo" Checked="cbEcho_Changed" Unchecked="cbEcho_Changed" />
                </GroupBox.Header>
                <StackPanel>
                    <Label Content="Delay, ms" />
                    <Slider x:Name="slEchoDelay" Minimum="50" Maximum="1000" Value="300"
                            AutoToolTipPlacement="TopLeft" ValueChanged="slEchoDelay_ValueChanged" />
                    <Label Content="Intensity" Margin="0,10,0,0" />
                    <Slider x:Name="slEchoIntensity" Maximum="1" Value="0.5"
                            AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2"
                            ValueChanged="slEchoIntensity_ValueChanged" />
                </StackPanel>
            </GroupBox>

            <GroupBox Width="200" Margin="10,0,0,0" Padding="5">
                <GroupBox.Header>
                    <CheckBox x:Name="cbReverb" Content="Reverb" Checked="cbReverb_Changed" Unchecked="cbReverb_Changed" />
                </GroupBox.Header>
                <StackPanel>
                    <Label Content="Room size" />
                    <Slider x:Name="slReverbRoom" Maximum="1" Value="0.8"
                            AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2"
                            ValueChanged="slReverbRoom_ValueChanged" />
                    <Label Content="Level (wet/dry)" Margin="0,10,0,0" />
                    <Slider x:Name="slReverbLevel" Maximum="1" Value="0.5"
                            AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2"
                            ValueChanged="slReverbLevel_ValueChanged" />
                </StackPanel>
            </GroupBox>

            <GroupBox Width="200" Margin="10,0,0,0" Padding="5">
                <GroupBox.Header>
                    <CheckBox x:Name="cbPitch" Content="Pitch" Checked="cbPitch_Changed" Unchecked="cbPitch_Changed" />
                </GroupBox.Header>
                <StackPanel>
                    <Label Content="Semitones" />
                    <Slider x:Name="slPitch" Minimum="-12" Maximum="12" Value="4"
                            TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                            AutoToolTipPlacement="TopLeft" ValueChanged="slPitch_ValueChanged" />
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.RowSpan="3" Margin="10,0,0,0">
            <Label Content="File" />
            <DockPanel>
                <Button x:Name="btOpen" Content="..." DockPanel.Dock="Right" Width="30" Margin="5,0,0,0"
                        Click="btOpen_Click" />
                <TextBox x:Name="edFilename" />
            </DockPanel>

            <Label Content="Audio output" Margin="0,10,0,0" />
            <ComboBox x:Name="cbSpeakers" />

            <Label Content="Volume" Margin="0,10,0,0" />
            <Slider x:Name="slVolume" Maximum="100" Value="80" AutoToolTipPlacement="TopLeft"
                    ValueChanged="slVolume_ValueChanged" />

            <Label Content="Log" Margin="0,10,0,0" />
            <TextBox x:Name="edLog" Height="150" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </StackPanel>
    </Grid>
</Window>
