<Window x:Class="Video_Stabilization_Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Video_Stabilization_Demo"
        xmlns:wpf="clr-namespace:VisioForge.Core.UI.WPF;assembly=VisioForge.Core"
        mc:Ignorable="d"
        Title="Media Blocks SDK .Net - Video Stabilization Demo" Height="560" Width="900"
        Loaded="Window_Loaded" Closing="Window_Closing" Icon="visioforge_main_icon.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <wpf:VideoView Grid.Column="1" x:Name="VideoView1" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="380" Margin="10,10,10,0" Width="500"/>

        <StackPanel Grid.Column="1" Orientation="Vertical" Margin="10,400,10,10" VerticalAlignment="Bottom">
            <Label Content="Log" />
            <TextBox x:Name="mmLog" Height="100" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" AcceptsReturn="True"/>
        </StackPanel>

        <StackPanel Grid.Column="0" Orientation="Vertical" Margin="10,10,0,50">
            <Label Content="Video file" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="edVideoFile" Width="270" VerticalContentAlignment="Center"/>
                <Button x:Name="btSelectVideoFile" Content="..." Width="40" Margin="10,0,0,0" Click="btSelectVideoFile_Click"/>
            </StackPanel>

            <Separator Margin="0,12"/>

            <CheckBox x:Name="chkEnabled" Content="Stabilization enabled" IsChecked="True" IsEnabled="False" Checked="chkEnabled_Changed" Unchecked="chkEnabled_Changed"/>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Label Content="Smoothing radius" Width="130"/>
                <Slider x:Name="slRadius" Minimum="1" Maximum="60" Value="15" IsEnabled="False" Width="150" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="slRadius_ValueChanged"/>
                <Label Content="{Binding Value, ElementName=slRadius}" Width="40"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Label Content="Crop ratio" Width="130"/>
                <Slider x:Name="slCrop" Minimum="0.5" Maximum="1.0" Value="0.9" IsEnabled="False" Width="150" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="slCrop_ValueChanged"/>
                <Label Content="{Binding Value, ElementName=slCrop, StringFormat=F2}" Width="40"/>
            </StackPanel>

            <Separator Margin="0,12"/>

            <CheckBox x:Name="chkRecord" Content="Record stabilized output to MP4" Checked="chkRecord_Changed" Unchecked="chkRecord_Changed"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBox x:Name="edOutputFile" Width="270" VerticalContentAlignment="Center" IsEnabled="False"/>
                <Button x:Name="btSelectOutputFile" Content="..." Width="40" Margin="10,0,0,0" IsEnabled="False" Click="btSelectOutputFile_Click"/>
            </StackPanel>

            <TextBlock TextWrapping="Wrap" Margin="0,12,10,0" Foreground="Gray"
                       Text="Real-time video stabilization (OpenCV vfdeshake). Larger smoothing radius = steadier but slower-reacting. Lower crop ratio zooms in more to hide the borders exposed by compensation."/>
        </StackPanel>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10,0,0,12">
            <Button x:Name="btStart" Content="Start" Width="120" Height="30" Click="btStart_Click"/>
            <Button x:Name="btStop" Content="Stop" Width="120" Height="30" Margin="10,0,0,0" Click="btStop_Click" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
