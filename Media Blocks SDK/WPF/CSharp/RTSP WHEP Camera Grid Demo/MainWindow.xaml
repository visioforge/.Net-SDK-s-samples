<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="RTSP_WHEP_Camera_Grid_Demo.MainWindow"
        mc:Ignorable="d"
        Title="Media Blocks SDK .Net - RTSP WHEP Camera Grid Demo" Height="560" Width="820" Loaded="Window_Loaded" Closing="Window_Closing" Icon="visioforge_main_icon.ico">
    <Grid Margin="10">
        <StackPanel>
            <Label Content="Camera RTSP URL" FontWeight="Bold"/>
            <TextBox x:Name="edURL" ToolTip="rtsp://&lt;camera-ip&gt;:554/stream1" VerticalContentAlignment="Center" Height="24"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Label Content="Login" Width="50"/>
                <TextBox x:Name="edLogin" Width="150" VerticalContentAlignment="Center"/>
                <Label Content="Password" Margin="15,0,0,0" Width="65"/>
                <PasswordBox x:Name="edPassword" Width="150" VerticalContentAlignment="Center"/>
                <Button x:Name="btAdd" Content="Add camera" Width="100" Margin="15,0,0,0" Click="btAdd_Click"/>
            </StackPanel>

            <Label Content="Cameras and their WHEP URLs" FontWeight="Bold" Margin="0,10,0,0"/>
            <ListBox x:Name="lbCameras" Height="120"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="Web page port"/>
                <TextBox x:Name="edPagePort" Width="70" Text="8080" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="cbAudio" Content="Camera audio" IsChecked="True" Margin="15,0,0,0" VerticalAlignment="Center"/>
                <Button x:Name="btStart" Content="Start" Width="60" Margin="15,0,0,0" Click="btStart_Click"/>
                <Button x:Name="btStop" Content="Stop" Width="60" Margin="10,0,0,0" IsEnabled="False" Click="btStop_Click"/>
                <TextBlock Margin="15,0,0,0" VerticalAlignment="Center">
                    <Hyperlink x:Name="lnkPage" IsEnabled="False" Click="lnkPage_Click"><Run x:Name="lbPageUrl" Text="Grid page: start first"/></Hyperlink>
                </TextBlock>
                <TextBlock x:Name="lbViewers" Text="Viewer sessions: 0" Margin="15,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBox x:Name="mmLog" Height="180" Margin="0,10,0,0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
        </StackPanel>
    </Grid>
</Window>
