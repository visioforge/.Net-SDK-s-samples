<Window x:Class="Video_Stabilization_Camera_Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:WPF="clr-namespace:VisioForge.Core.UI.WPF;assembly=VisioForge.Core"
        Title="Live Camera Stabilization (Media Blocks)" Height="640" Width="1040"
        Loaded="Window_Loaded" Closing="Window_Closing" Icon="visioforge_main_icon.ico">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <WPF:VideoView x:Name="VideoView1" Grid.Column="0" Margin="0,0,8,0" />

        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Camera" FontWeight="Bold" />
                <ComboBox x:Name="cbCamera" Margin="0,2,0,8" SelectionChanged="cbCamera_SelectionChanged" />

                <TextBlock Text="Format" FontWeight="Bold" />
                <ComboBox x:Name="cbFormat" Margin="0,2,0,8" />

                <CheckBox x:Name="chkEnabled" Content="Stabilization enabled (A/B)" IsChecked="True" IsEnabled="False" Margin="0,0,0,8"
                          Checked="chkEnabled_Changed" Unchecked="chkEnabled_Changed" />

                <TextBlock x:Name="lbSmoothing" Text="Smoothing radius: 15 frames" />
                <Slider x:Name="slSmoothing" Minimum="1" Maximum="120" Value="15" IsSnapToTickEnabled="True" TickFrequency="1" IsEnabled="False"
                        Margin="0,2,0,8" ValueChanged="Slider_ValueChanged" />

                <TextBlock x:Name="lbCropRatio" Text="Crop ratio: 0.90" />
                <Slider x:Name="slCropRatio" Minimum="0.5" Maximum="1.0" Value="0.9" IsEnabled="False"
                        Margin="0,2,0,8" ValueChanged="Slider_ValueChanged" />

                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                    <Button x:Name="btStart" Content="Start" Width="90" Click="btStart_Click" />
                    <Button x:Name="btStop" Content="Stop" Width="90" Margin="8,0,0,0" IsEnabled="False" Click="btStop_Click" />
                </StackPanel>

                <TextBlock Text="Log" FontWeight="Bold" />
            </StackPanel>

            <TextBox x:Name="mmLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" />
        </DockPanel>
    </Grid>
</Window>
