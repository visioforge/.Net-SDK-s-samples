<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:WPF="clr-namespace:VisioForge.Core.UI.WPF;assembly=VisioForge.Core"
        x:Class="WebRTC_Video_Call_Demo.MainWindow"
        mc:Ignorable="d"
        Title="Media Blocks SDK .Net - WebRTC Video Call Demo" Height="640" Width="1031" Loaded="Window_Loaded" Closing="Window_Closing" Icon="visioforge_main_icon.ico">
    <Grid>

        <Label Content="Browser" HorizontalAlignment="Left" Margin="366,5,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        <WPF:VideoView x:Name="RemoteView" HorizontalAlignment="Left" Height="360" Margin="366,32,0,0" VerticalAlignment="Top" Width="640"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="366,405,0,0">
            <Button x:Name="btStart" Content="Start" Width="50" Click="btStart_Click"/>
            <Button x:Name="btStop" Content="Stop" Width="50" Margin="10,0,0,0" IsEnabled="False" Click="btStop_Click"/>
            <ToggleButton x:Name="btMute" Content="Mute" Width="70" Margin="20,0,0,0" IsEnabled="False" Click="btMute_Click"/>
            <ToggleButton x:Name="btCameraOff" Content="Camera off" Width="80" Margin="10,0,0,0" IsEnabled="False" Click="btCameraOff_Click"/>
            <TextBlock Margin="15,0,0,0" VerticalAlignment="Center">
                <Hyperlink x:Name="lnkCall" IsEnabled="False" Click="lnkCall_Click"><Run x:Name="lbCallUrl" Text="Call page: press Start first"/></Hyperlink>
            </TextBlock>
        </StackPanel>

        <TextBox x:Name="mmLog" HorizontalAlignment="Left" Height="170" Margin="366,435,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="640" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>

        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" Width="340">

            <StackPanel Orientation="Horizontal">
                <Label Content="Camera" Width="90"/>
                <ComboBox x:Name="cbVideoInput" Width="240" VerticalContentAlignment="Center" SelectionChanged="cbVideoInput_SelectionChanged"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="Format" Width="90"/>
                <ComboBox x:Name="cbVideoFormat" Width="170" VerticalContentAlignment="Center" SelectionChanged="cbVideoFormat_SelectionChanged"/>
                <ComboBox x:Name="cbVideoFrameRate" Margin="10,0,0,0" Width="60" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Label Content="Microphone" Width="90"/>
                <ComboBox x:Name="cbAudioInput" Width="240" VerticalContentAlignment="Center" SelectionChanged="cbAudioInput_SelectionChanged"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="Format" Width="90"/>
                <ComboBox x:Name="cbAudioFormat" Width="240" VerticalContentAlignment="Center"/>
            </StackPanel>

            <Separator Margin="0,15,0,0"/>

            <Label Content="WebRTC" FontWeight="Bold" Margin="0,10,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="Web page port" Width="130"/>
                <TextBox x:Name="edWebPort" Width="80" Text="8080" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="Signalling port" Width="130"/>
                <TextBox x:Name="edSignallingPort" Width="80" Text="8443" VerticalContentAlignment="Center"/>
            </StackPanel>

            <Label Content="You (sent to the browser)" FontWeight="Bold" Margin="0,15,0,0"/>
            <WPF:VideoView x:Name="LocalView" HorizontalAlignment="Left" Height="180" Width="320"/>

        </StackPanel>
    </Grid>
</Window>
