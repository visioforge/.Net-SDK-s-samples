<Window x:Class="RTMP_Source_Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:VisioForge.Core.UI.WPF;assembly=VisioForge.Core"
        Title="RTMP Source Demo - Media Blocks SDK .Net" Height="360" Width="733" Icon="visioforge_main_icon.ico" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Vertical" Grid.Column="0" Width="250" Margin="10,10,0,0">
            <Label Content="RTMP URL" Margin="0,0,10,0" />
            <TextBox x:Name="edURL" HorizontalAlignment="Stretch" Margin="0,0,10,0" Text="rtmp://127.0.0.1:1935/live/stream" />
            <Label Content="Audio output" Margin="0,10,10,0" />
            <ComboBox x:Name="cbAudioOutput" HorizontalAlignment="Stretch" Margin="0,0,10,0" />
            <Label Content="Volume" Margin="0,10,10,0" />
            <Slider x:Name="tbVolume" HorizontalAlignment="Stretch" Margin="0,0,10,0" Maximum="100" Value="80" ValueChanged="tbVolume_ValueChanged" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,15,10,0">
                <Button x:Name="btStart" Content="Start" Width="50" Margin="0,0,5,0" Click="btStart_Click" />
                <Button x:Name="btStop" Content="Stop" Width="50" Margin="0,0,5,0" IsEnabled="False" Click="btStop_Click" />
            </StackPanel>
            <TextBlock x:Name="lbError" Margin="0,10,10,0" TextWrapping="Wrap" Foreground="Red" />
        </StackPanel>

        <wpf:VideoView Grid.Column="1" Margin="10,10,0,0" Width="420" Height="240" Name="VideoView1" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Black" />
    </Grid>
</Window>
