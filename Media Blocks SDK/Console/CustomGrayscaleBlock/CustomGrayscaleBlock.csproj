<?xml version="1.0" encoding="utf-8"?><Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><OutputType>Exe</OutputType><TargetFramework Condition="$([MSBuild]::IsOsPlatform('MacOS'))">net10.0-macos</TargetFramework><TargetFrameworks Condition="$([MSBuild]::IsOsPlatform('Windows'))">net10.0-windows</TargetFrameworks><TargetFramework Condition="$([MSBuild]::IsOsPlatform('Linux'))">net8.0</TargetFramework><Nullable>disable</Nullable><LangVersion>latest</LangVersion><ApplicationId>com.visioforge.customgrayscaleblock</ApplicationId><RootNamespace>CustomGrayscaleBlockSample</RootNamespace><RunWithOpen Condition="$([MSBuild]::IsOsPlatform('OSX'))">false</RunWithOpen></PropertyGroup><ItemGroup><PackageReference Include="VisioForge.DotNet.MediaBlocks" Version="[2026.11.16]" /></ItemGroup><ItemGroup Condition="$([MSBuild]::IsOsPlatform('Windows'))"><PackageReference Include="VisioForge.CrossPlatform.Core.Windows.x64" Version="[2026.11.16]" /><PackageReference Include="VisioForge.CrossPlatform.Libav.Windows.x64.UPX" Version="[2026.11.16]" /></ItemGroup><ItemGroup Condition="$(TargetFramework.Contains('-macos'))"><PackageReference Include="VisioForge.CrossPlatform.Core.macOS" Version="[2026.11.13]" /></ItemGroup><!-- Linux: VisioForge native libraries (GStreamer comes from the system); the package follows the runtime identifier. --><ItemGroup Condition="$([MSBuild]::IsOsPlatform('Linux'))"><PackageReference Include="VisioForge.CrossPlatform.Core.Linux.arm64" Version="[2026.10.26]" Condition="$(RuntimeIdentifier.EndsWith('-arm64')) or ('$(RuntimeIdentifier)' == '' and $(NETCoreSdkRuntimeIdentifier.EndsWith('-arm64')))" /><PackageReference Include="VisioForge.CrossPlatform.Core.Linux.x64" Version="[2026.10.26]" Condition="!($(RuntimeIdentifier.EndsWith('-arm64')) or ('$(RuntimeIdentifier)' == '' and $(NETCoreSdkRuntimeIdentifier.EndsWith('-arm64'))))" /></ItemGroup></Project>