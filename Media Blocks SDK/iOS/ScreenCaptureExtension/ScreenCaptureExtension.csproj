<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ScreenCaptureExtension</RootNamespace>
    <AssemblyName>ScreenCaptureExtension</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <SupportedOSPlatformVersion>16.4</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Device only (the simulator does not run broadcast extensions); ScreenCapture's embed step expects this RID's output folder. -->
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <!-- Build an app extension bundle (.appex); ScreenCapture copies it into its PlugIns folder. -->
    <IsAppExtension>true</IsAppExtension>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    <!-- Static registrar: with the default one the extension crashes in -[SampleHandler init], which iOS calls before any managed code of the extension has run. -->
    <Registrar>static</Registrar>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <CodesignKey>iPhone Developer</CodesignKey>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <CreatePackage>false</CreatePackage>
    <MtouchLink>SdkOnly</MtouchLink>
    <MtouchNoSymbolStrip>True</MtouchNoSymbolStrip>
    <MtouchDebug>True</MtouchDebug>
    <CodesignKey>iPhone Developer</CodesignKey>
    <DeviceSpecificBuild>true</DeviceSpecificBuild>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <CreatePackage>false</CreatePackage>
    <MtouchNoSymbolStrip>True</MtouchNoSymbolStrip>
    <MtouchDebug>False</MtouchDebug>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Info.plist">
      <LogicalName>Info.plist</LogicalName>
    </None>
    <None Include="Entitlements.plist" />
  </ItemGroup>
</Project>