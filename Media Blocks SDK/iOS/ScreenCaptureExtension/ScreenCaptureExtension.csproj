<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ScreenCaptureExtension</RootNamespace>
    <AssemblyName>ScreenCaptureExtension</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <SupportedOSPlatformVersion>16.4</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Device-only: Broadcast Upload Extensions only run on real iOS devices; the
         simulator does not host system broadcast extensions, so building this project
         for iossimulator-* would produce an unloadable .appex. Pinning the RID also
         matches the parent ScreenCapture.csproj device-only pin (the parent's
         EmbedBroadcastExtension target expects the .appex under the same RID subfolder).
         See the parent project comment for the .NET iOS 10 / SkiaSharp.NativeAssets.iOS
         RID-resolution background. -->
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <!-- Tell the .NET iOS tooling to build this project as an app extension bundle (.appex)
         instead of a standalone .app. The main app's csproj references this one and the
         tooling embeds the resulting .appex inside the main bundle's Plugins/ directory. -->
    <IsAppExtension>true</IsAppExtension>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    <!-- The managed static registrar crashes an extension on its first callback: iOS calls
         -[SampleHandler init] before any managed code of this assembly has run, so its AOT
         module is not initialized yet (#4015). The static registrar initializes it on the call. -->
    <Registrar>static</Registrar>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <CodesignKey>iPhone Developer</CodesignKey>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <CreatePackage>false</CreatePackage>
    <MtouchLink>SdkOnly</MtouchLink>
    <MtouchNoSymbolStrip>True</MtouchNoSymbolStrip>
    <MtouchDebug>True</MtouchDebug>
    <CodesignKey>iPhone Developer</CodesignKey>
    <DeviceSpecificBuild>true</DeviceSpecificBuild>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <CreatePackage>false</CreatePackage>
    <MtouchNoSymbolStrip>True</MtouchNoSymbolStrip>
    <MtouchDebug>False</MtouchDebug>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Info.plist">
      <LogicalName>Info.plist</LogicalName>
    </None>
    <None Include="Entitlements.plist" />
  </ItemGroup>
</Project>