<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.visioforge.usbcameramb">
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:label="@string/app_name" android:supportsRtl="true"></application>
	<!-- Android denies access to USB video class devices unless the app holds the camera
	     permission, even though the Camera2 API is never used here. -->
	<uses-permission android:name="android.permission.CAMERA" />
	<!-- That permission otherwise makes a built-in camera an implied REQUIREMENT, which would
	     hide this app from exactly the devices it targets: ones whose camera arrives over USB. -->
	<uses-feature android:name="android.hardware.camera" android:required="false" />
	<uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
	<uses-feature android:name="android.hardware.usb.host" android:required="true" />
</manifest>
