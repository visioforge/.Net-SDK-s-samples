<Window x:Class="Simple_Video_Capture_MF.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:my="clr-namespace:VisioForge.Core.UI.WPF;assembly=VisioForge.Core"
        Title="Simple Video Capture (Media Foundation)" Height="512" Width="864"
        Loaded="Window_Loaded" Closing="Window_Closing" Icon="visioforge_main_icon.ico">
    <Grid>
        <Grid HorizontalAlignment="Left" Margin="12,12,0,46" Width="390">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="Camera"/>
            <ComboBox Grid.Row="1" x:Name="cbCamera" Margin="6,0,6,8" DisplayMemberPath="Name" SelectionChanged="cbCamera_SelectionChanged"/>
            <Label Grid.Row="2" Content="Size reported by Media Foundation"/>
            <ComboBox Grid.Row="3" x:Name="cbFormat" Margin="6,0,6,8" DisplayMemberPath="Name" SelectionChanged="cbFormat_SelectionChanged"/>
            <Label Grid.Row="4" Content="Frame rate"/>
            <ComboBox Grid.Row="5" x:Name="cbFrameRate" Margin="6,0,6,8"/>
            <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="6,0,6,8">
                <RadioButton x:Name="rbPreview" Content="Preview" IsChecked="True" Margin="0,0,16,0"/>
                <RadioButton x:Name="rbCapture" Content="Capture MP4"/>
            </StackPanel>
            <DockPanel Grid.Row="7" Margin="6,0,6,8">
                <Button x:Name="btSelectOutput" Content="..." Width="28" DockPanel.Dock="Right" Margin="6,0,0,0" Click="btSelectOutput_Click"/>
                <TextBox x:Name="edOutput"/>
            </DockPanel>
            <TextBox Grid.Row="8" x:Name="mmLog" Margin="6,0,6,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </Grid>
        <my:VideoView x:Name="VideoView1" Margin="414,12,12,46" Background="Black"/>
        <Button x:Name="btStart" Content="Start" Width="70" Height="26" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,90,12" Click="btStart_Click"/>
        <Button x:Name="btStop" Content="Stop" Width="70" Height="26" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12" Click="btStop_Click"/>
    </Grid>
</Window>
