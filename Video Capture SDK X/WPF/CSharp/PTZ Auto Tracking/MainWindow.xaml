<Window x:Class="PTZ_Auto_Tracking.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:WPF="clr-namespace:VisioForge.Core.UI.WPF;assembly=VisioForge.Core"
        Title="PTZ Auto-Tracking (VideoCaptureCoreX + ONVIF)" Height="680" Width="1080"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="1" Padding="6" Margin="0,8,0,0">
                <TextBlock x:Name="txtStatus" Text="Idle" FontFamily="Consolas" FontSize="12" />
            </Border>
            <WPF:VideoView x:Name="VideoView1" />
        </DockPanel>

        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="RTSP camera URL" FontWeight="Bold" />
                <TextBox x:Name="edRtspUrl" Margin="0,2,0,8"
                         Text="rtsp://192.168.1.22:554/cam/realmonitor?channel=1&amp;subtype=0&amp;unicast=true&amp;proto=Onvif" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="User" FontWeight="Bold" />
                        <TextBox x:Name="edUser" Text="admin" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                        <TextBlock Text="Password" FontWeight="Bold" />
                        <TextBox x:Name="edPassword" Text="dancer23" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="ONVIF device service URL" FontWeight="Bold" />
                <TextBox x:Name="edOnvifUrl" Margin="0,2,0,8"
                         Text="http://192.168.1.22/onvif/device_service" />

                <TextBlock Text="YOLO model" FontWeight="Bold" />
                <ComboBox x:Name="cbModel" Margin="0,2,0,4" SelectionChanged="cbModel_SelectionChanged" />
                <DockPanel Margin="0,0,0,8">
                    <Button x:Name="btDownloadModel" DockPanel.Dock="Right" Content="Download" Width="84" Margin="6,0,0,0" Click="btDownloadModel_Click" Visibility="Collapsed" />
                    <Button x:Name="btSelectModel" DockPanel.Dock="Right" Content="..." Width="32" Click="btSelectModel_Click" Visibility="Collapsed" />
                    <TextBox x:Name="edModel" IsReadOnly="True" />
                </DockPanel>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="Target" FontWeight="Bold" />
                        <ComboBox x:Name="cbTarget" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                        <TextBlock Text="Min confidence %" FontWeight="Bold" />
                        <TextBox x:Name="edConfidence" Text="40" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="chkTracking" Content="Enable PTZ auto-tracking" IsChecked="True" Margin="0,0,0,8"
                          Checked="chkTracking_Changed" Unchecked="chkTracking_Changed" />

                <CheckBox x:Name="chkPatrol" Content="Idle patrol when no target" IsChecked="False" Margin="0,0,0,4" />
                <TextBlock Text="Patrol preset tokens (comma-separated)" FontWeight="Bold" />
                <TextBox x:Name="edPatrolPresets" Text="1, 2, 3" Margin="0,2,0,8" />

                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                    <Button x:Name="btStart" Content="Start" Width="90" Click="btStart_Click" />
                    <Button x:Name="btStop" Content="Stop" Width="90" Margin="8,0,0,0" IsEnabled="False" Click="btStop_Click" />
                </StackPanel>

                <TextBlock Text="Log" FontWeight="Bold" />
            </StackPanel>

            <TextBox x:Name="mmLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" />
        </DockPanel>
    </Grid>
</Window>
