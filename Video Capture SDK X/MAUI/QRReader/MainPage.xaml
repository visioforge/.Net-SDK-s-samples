<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QRReader.MainPage"
             xmlns:my="clr-namespace:VisioForge.Core.UI.MAUI;assembly=VisioForge.Core.UI.MAUI">

    <!-- No ScrollView: a camera page should fill the viewport so the preview takes the star row.
         A ScrollView gives the star row infinite height and breaks the live-preview sizing. -->
    <Grid RowDefinitions="Auto,*">

        <StackLayout Grid.Row="0" x:Name="pnMain" Orientation="Vertical" HorizontalOptions="Fill" Background="#1e1e1e">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button 
                        x:Name="btCamera" 
                        Text="CAMERA" 
                        Grid.Column="0" 
                        HorizontalOptions="Start" 
                        Margin="10" 
                        Clicked="btCamera_Clicked" />

                    <Button  
                        Grid.Column="1"
                        x:Name="btPlayStop"   
                        Text="START" 
                        Margin="10" 
                        Clicked="btPlayStop_Clicked" 
                        HorizontalOptions="EndAndExpand"/>
                </Grid>

                <Label
                    Text="BARCODE"
                    TextColor="White"
                    x:Name="lbBarcode"
                    HorizontalOptions="Fill"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="TailTruncation"
                    MaxLines="1"
                    Margin="10,0,10,10" />
            </StackLayout>

            <my:VideoView Grid.Row="1"               
                HorizontalOptions="FillAndExpand"
                VerticalOptions="FillAndExpand"
                x:Name="videoView"
                Margin="0" 
                Background="Black"/>
    </Grid>

</ContentPage>
